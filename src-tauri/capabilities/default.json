{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "webviews": ["content"],
  "remote": {
    "urls": ["https://anivox.fun/*"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "allow-set-discord-rpc",
    "allow-player-status",
    "allow-site-lifecycle",
    "allow-mpv-commands",
    "allow-browser-controls",
    "allow-settings-window",
    "allow-connection-window",
    "allow-segment-stats-report",
    "allow-shikimori-controls",
    "allow-check-update",
    "allow-update-review"
  ]
}
