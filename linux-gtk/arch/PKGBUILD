# Maintainer: axell
#
# Native Linux shell (GTK4 + WebKitGTK 6.0). Builds from this checkout instead of
# a tarball: run `makepkg -fi` inside linux-gtk/arch. Replaces the retired Tauri
# package `anivox` (pacman asks to remove it; settings in ~/.config stay).
pkgname=anivox-gtk
pkgver=0.5.0
pkgrel=1
pkgdesc="Anivox Desktop - native GTK4 + WebKitGTK shell for anivox.fun"
arch=('x86_64')
url="https://anivox.fun/"
license=('unknown')
depends=('gtk4' 'webkitgtk-6.0')
makedepends=('cargo' 'pkgconf')
optdepends=(
    'mpv: external player support'
    'polkit: install updates from the app (pkexec)'
)
provides=('anivox')
conflicts=('anivox')
replaces=('anivox')
# ring and other C code in the dependency tree break under makepkg's default -flto.
options=('!debug' '!lto')

_root() {
    # linux-gtk/arch -> repository root
    echo "${startdir}/../.."
}

# Build from a snapshot in $srcdir: makepkg keeps arch/pkg unreadable during
# build(), and cargo fails when it rescans the crate directory containing it.
prepare() {
    local root tree
    root="$(_root)"
    tree="${srcdir}/tree"
    rm -rf "${tree}"
    mkdir -p "${tree}/linux-gtk" "${tree}/src-tauri"
    cp -r "${root}/linux-gtk/"{Cargo.toml,Cargo.lock,build.rs,src,scripts,data} "${tree}/linux-gtk/"
    cp -r "${root}/src-tauri/"{anivox-core,scripts,icons} "${tree}/src-tauri/"
}

build() {
    cd "${srcdir}/tree/linux-gtk"
    export CARGO_TARGET_DIR="${srcdir}/target"
    export RUSTUP_TOOLCHAIN=stable
    export RUSTFLAGS="${RUSTFLAGS} --remap-path-prefix=${srcdir}=/usr/src/anivox-gtk"
    cargo build --release --locked
}

check() {
    cd "${srcdir}/tree/linux-gtk"
    export CARGO_TARGET_DIR="${srcdir}/target"
    export RUSTUP_TOOLCHAIN=stable
    export RUSTFLAGS="${RUSTFLAGS} --remap-path-prefix=${srcdir}=/usr/src/anivox-gtk"
    cargo test --release --locked
}

package() {
    local root
    root="$(_root)"

    install -Dm755 "${srcdir}/target/release/anivox-gtk" "${pkgdir}/usr/bin/anivox-gtk"

    # The desktop file name equals the GApplication id so shells match the window to it.
    install -Dm644 "${root}/linux-gtk/data/com.yasin.anivox.gtk.desktop" \
        "${pkgdir}/usr/share/applications/com.yasin.anivox.gtk.desktop"

    local icons="${root}/src-tauri/icons"
    install -Dm644 "${icons}/32x32.png" "${pkgdir}/usr/share/icons/hicolor/32x32/apps/anivox-gtk.png"
    install -Dm644 "${icons}/128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/anivox-gtk.png"
    install -Dm644 "${icons}/128x128@2x.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/anivox-gtk.png"
    install -Dm644 "${icons}/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/anivox-gtk.png"
}
