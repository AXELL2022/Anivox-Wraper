<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Anivox.WinUI</RootNamespace>
    <AssemblyName>anivox-winui</AssemblyName>
    <Version>0.5.1</Version>
    <Product>Anivox</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\src-tauri\icons\icon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLower())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <!-- Program.cs owns Main: single instance via AppInstance before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Unpackaged exe: no MSIX, Windows App SDK runtime is copied next to the exe. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Without it `dotnet publish` drops resources.pri and the compiled XAML (.xbf). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Rust core (windows-winui/native, anivox_ffi.dll) built by cargo for the same platform. -->
  <PropertyGroup>
    <CargoTarget Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</CargoTarget>
    <CargoTarget Condition="'$(CargoTarget)' == ''">x86_64-pc-windows-msvc</CargoTarget>
    <CargoProfile Condition="'$(Configuration)' == 'Release'">release</CargoProfile>
    <CargoProfile Condition="'$(CargoProfile)' == ''">debug</CargoProfile>
    <CargoFlags Condition="'$(Configuration)' == 'Release'">--release</CargoFlags>
    <NativeDir>$(MSBuildThisFileDirectory)native\</NativeDir>
    <NativeDll>$(NativeDir)target\$(CargoTarget)\$(CargoProfile)\anivox_ffi.dll</NativeDll>
  </PropertyGroup>

  <Target Name="BuildAnivoxCore" BeforeTargets="BeforeBuild" Condition="'$(SkipCargo)' != 'true'">
    <Exec Command="cargo build --locked $(CargoFlags) --target $(CargoTarget) --manifest-path &quot;$(NativeDir)Cargo.toml&quot;" />
  </Target>

  <ItemGroup>
    <None Include="$(NativeDll)" Link="anivox_ffi.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\src-tauri\icons\icon.ico" Link="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>
</Project>
