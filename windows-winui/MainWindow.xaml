<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anivox.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Anivox">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Height must match TitleBarHeightOption.Tall (48), or the caption input window overlaps the site. -->
        <Grid x:Name="TitleBar" Height="48" Padding="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionInset" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="NavButtons" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="BackButton" Click="OnBack" AutomationProperties.Name="Назад" IsEnabled="False" ToolTipService.ToolTip="Назад"
                        Style="{StaticResource SubtleButtonStyle}" Padding="8,6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button x:Name="ForwardButton" Click="OnForward" AutomationProperties.Name="Вперёд" IsEnabled="False" ToolTipService.ToolTip="Вперёд"
                        Style="{StaticResource SubtleButtonStyle}" Padding="8,6">
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                </Button>
                <Button x:Name="ReloadButton" Click="OnReload" AutomationProperties.Name="Обновить" ToolTipService.ToolTip="Обновить"
                        Style="{StaticResource SubtleButtonStyle}" Padding="8,6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button Click="OnHome" ToolTipService.ToolTip="Главная" AutomationProperties.Name="Главная"
                        Style="{StaticResource SubtleButtonStyle}" Padding="8,6">
                    <FontIcon Glyph="&#xE80F;" FontSize="14" />
                </Button>
                <!-- Hands the current episode to MPV; shows the player status from the site (report_player_status). -->
                <Button x:Name="MpvButton" Click="OnMpv" AutomationProperties.Name="Открыть в MPV" ToolTipService.ToolTip="Открыть текущее видео в MPV (M / Ь)"
                        Style="{StaticResource SubtleButtonStyle}" Padding="10,6" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                        <TextBlock x:Name="MpvLabel" Text="MPV" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="ShikimoriButton" Click="OnShikimoriToggle" Content="Shikimori"
                              AutomationProperties.Name="Shikimori" ToolTipService.ToolTip="Открыть Shikimori поверх сайта"
                              Padding="10,4" Margin="2,0,0,0" />
            </StackPanel>
            <StackPanel x:Name="DragRegion" Grid.Column="1" Orientation="Horizontal" Spacing="8" Padding="12,0,0,0"
                        Background="Transparent">
                <TextBlock Text="Anivox" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <ProgressRing x:Name="Loading" Width="14" Height="14" IsActive="False" VerticalAlignment="Center" />
                <!-- Longer player explanations (status detail, launch timeout). -->
                <TextBlock x:Name="PlayerMessage" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextTrimming="CharacterEllipsis"
                           MaxWidth="420" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,4,0">
                <!-- Appears when latest.json announces a newer version (port of GTK updater.rs). -->
                <Button x:Name="UpdateButton" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}"
                        Padding="10,4" AutomationProperties.Name="Обновление Anivox" Content="Обновление">
                    <Button.Flyout>
                        <Flyout x:Name="UpdateFlyout" Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="False">
                            <StackPanel Width="440" Spacing="10">
                                <TextBlock x:Name="UpdateTitle" Text="Обновление Anivox" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="UpdateCurrent" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <ScrollViewer MaxHeight="360" MinHeight="160" Padding="10,8">
                                        <!-- Release notes as plain text, never rendered as HTML. -->
                                        <TextBlock x:Name="UpdateNotes" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </ScrollViewer>
                                </Border>
                                <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Text="Перед установкой ознакомьтесь с изменениями." />
                                <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Maximum="100" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="UpdateOpen" Content="Открыть страницу обновления"
                                            Style="{StaticResource AccentButtonStyle}" Click="OnUpdateOpen" />
                                    <Button x:Name="UpdateCancel" Content="Отмена" Visibility="Collapsed" Click="OnUpdateCancel" />
                                    <Button x:Name="UpdateRetry" Content="Проверить снова" Click="OnUpdateRetry" />
                                    <Button Content="Позже" Click="OnUpdateLater" />
                                </StackPanel>
                                <HyperlinkButton x:Name="UpdatePage" Content="Страница выпуска" Padding="0" Click="OnUpdatePage" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!-- Connection check: is it the user's internet or the video server? -->
                <Button x:Name="ConnectionButton" ToolTipService.ToolTip="Проверить соединение: интернет или сайт"
                        AutomationProperties.Name="Проверка соединения" Style="{StaticResource SubtleButtonStyle}" Padding="8,6">
                    <FontIcon Glyph="&#xE701;" FontSize="14" />
                    <Button.Flyout>
                        <Flyout x:Name="ConnectionFlyout" Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="False"
                                Opening="OnConnectionOpening" Closed="OnConnectionClosed">
                            <StackPanel Width="360" Spacing="10">
                                <TextBlock Text="Проверка соединения" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <Grid ColumnSpacing="12" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Ваш интернет" />
                                    <TextBlock x:Name="ConnInternet" Grid.Column="1" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Row="1" Text="Видео с сайта" />
                                    <TextBlock x:Name="ConnVideo" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Grid>
                                <TextBlock x:Name="ConnDetail" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                                <MenuFlyoutSeparator />
                                <TextBlock x:Name="ConnVerdictTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ConnVerdictText" TextWrapping="Wrap" />
                                <Button x:Name="ConnRecheck" Content="Проверить снова" Click="OnConnectionRecheck" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" ToolTipService.ToolTip="Версия Anivox" />
                <Button x:Name="SettingsButton" ToolTipService.ToolTip="Настройки Anivox" AutomationProperties.Name="Настройки Anivox"
                        Style="{StaticResource SubtleButtonStyle}" Padding="8,6">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <Button.Flyout>
                        <!-- Not constrained to the root: the popup gets its own window above the site HWND. -->
                        <Flyout x:Name="SettingsFlyout" Placement="BottomEdgeAlignedRight"
                                ShouldConstrainToRootBounds="False" Opening="OnSettingsOpening">
                            <StackPanel Width="380" Spacing="8">
                                <TextBlock Text="Настройки Anivox" Style="{StaticResource SubtitleTextBlockStyle}" />

                                <TextBlock Text="Приложение" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="При запуске открывать" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ComboBox x:Name="StartupPage" Grid.Column="1" SelectionChanged="OnStartupPageChanged">
                                        <ComboBoxItem Content="Последнюю страницу Anivox" Tag="lastPage" />
                                        <ComboBoxItem Content="Главную страницу" Tag="home" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Размер, положение и развёрнутое состояние окна сохраняются автоматически. Восстановленная страница не запускает видео до взаимодействия с ней." />
                                <TextBlock x:Name="SessionStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />

                                <MenuFlyoutSeparator />
                                <TextBlock Text="MPV" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Путь к исполняемому файлу MPV" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="MpvPath" PlaceholderText="mpv из PATH" TextChanged="OnSettingsEdited" />
                                    <Button Grid.Column="1" Content="Обзор…" Click="OnBrowseMpv" />
                                </Grid>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Оставьте поле пустым для поиска MPV в PATH. Выбранный путь используется при следующем запуске видео." />
                                <CheckBox x:Name="MirrorEmbedded" Click="OnSettingsEdited">
                                    <TextBlock Text="Продолжать воспроизведение на сайте при просмотре в MPV" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="После запуска MPV встроенный плеер работает без звука на минимальном качестве и следует его паузе и позиции. Расход трафика и нагрузка увеличатся." />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Сохранить" Style="{StaticResource AccentButtonStyle}" Click="OnSaveSettings" />
                                    <Button Content="Сбросить путь" Click="OnResetMpvPath" />
                                </StackPanel>
                                <Button x:Name="ClearHistoryButton" Content="Очистить сохранённые позиции" Click="OnClearHistory" />

                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Журналы MPV сохраняются в папку данных Anivox:" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LogsPath" Style="{StaticResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                    <HyperlinkButton Grid.Column="1" Content="Открыть" Click="OnOpenLogs" />
                                </Grid>
                                <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- WebView2 is hosted as a child HWND over this area (windowed hosting, like Tauri):
             the XAML WebView2 control uses visual hosting, where video does not get the
             DirectComposition overlay NVIDIA RTX VSR needs. -->
        <!-- PlayerSnapshot stands in for the site while its WebView2 moves to/from player fullscreen. -->
        <Border x:Name="ContentHost" Grid.Row="1" Background="#0F0F0F">
            <Image x:Name="PlayerSnapshot" Stretch="Fill" />
        </Border>

        <!-- Site recovery screen (port of GTK site_recovery.rs): shown after a 25 s timeout or a load error.
             The site HWND is hidden meanwhile (XAML cannot cover it); a normal load only spins the title bar ring. -->
        <Grid x:Name="RecoveryLayer" Grid.Row="1" Visibility="Collapsed" Background="#101018">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="22" Margin="16">
                <TextBlock Text="ANIVOX" HorizontalAlignment="Center" CharacterSpacing="400" FontWeight="Bold"
                           FontSize="13" Foreground="#D3CEE8" />
                <Border Width="420" Padding="40,34,40,28" CornerRadius="24" BorderThickness="1"
                        BorderBrush="#12FFFFFF" Background="#E81A1923">
                    <StackPanel Spacing="12">
                        <ProgressRing x:Name="RecoverySpinner" Width="48" Height="48" IsActive="False" />
                        <TextBlock Text="ВАШ МИР АНИМЕ" HorizontalAlignment="Center" CharacterSpacing="300"
                                   FontWeight="Bold" FontSize="10" Foreground="#B5A3EE" />
                        <TextBlock x:Name="RecoveryTitle" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" FontSize="26" FontWeight="SemiBold" Foreground="#F3F2FF" />
                        <TextBlock x:Name="RecoveryDescription" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" FontSize="14" Foreground="#B3AFC3" />
                        <Border x:Name="RecoveryDetailBox" CornerRadius="10" Padding="12,10" Background="#660F0E16"
                                Visibility="Collapsed">
                            <TextBlock x:Name="RecoveryDetail" TextWrapping="Wrap" FontSize="12" Foreground="#CBC5DF"
                                       IsTextSelectionEnabled="True" />
                        </Border>
                        <StackPanel x:Name="RecoveryActions" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Content="Повторить загрузку" Style="{StaticResource AccentButtonStyle}" Click="OnRecoveryRetry" />
                            <Button Content="На зеркало" Click="OnRecoveryMirror" />
                            <Button Content="На главную" Click="OnRecoveryHome" />
                        </StackPanel>
                        <HyperlinkButton x:Name="RecoveryWait" Content="Продолжить ожидание" HorizontalAlignment="Center"
                                         Click="OnRecoveryWait" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Anivox Desktop · Немного терпения — и можно смотреть" HorizontalAlignment="Center"
                           FontSize="11" Foreground="#837D96" />
            </StackPanel>
        </Grid>

        <!-- Shikimori overlay. XAML cannot draw above a WebView2 HWND, so while it is open the site
             HWND is hidden (the page keeps running) and a dimmed snapshot of it is the backdrop. -->
        <Grid x:Name="ShikimoriLayer" Grid.Row="1" Visibility="Collapsed">
            <Image x:Name="ShikimoriSnapshot" Stretch="Fill" />
            <Border Background="#8C000000" Tapped="OnShikimoriBackdropTapped" />
            <Grid Margin="16" CornerRadius="12" BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="6,0" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ShikimoriBack" Click="OnShikimoriBack" IsEnabled="False" AutomationProperties.Name="Назад в Shikimori"
                            ToolTipService.ToolTip="Назад" Style="{StaticResource SubtleButtonStyle}" Padding="8,6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <Button x:Name="ShikimoriForward" Grid.Column="1" Click="OnShikimoriForward" IsEnabled="False"
                            AutomationProperties.Name="Вперёд в Shikimori" ToolTipService.ToolTip="Вперёд"
                            Style="{StaticResource SubtleButtonStyle}" Padding="8,6">
                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="2" Click="OnShikimoriReload" AutomationProperties.Name="Обновить Shikimori"
                            ToolTipService.ToolTip="Обновить" Style="{StaticResource SubtleButtonStyle}" Padding="8,6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <TextBlock x:Name="ShikimoriTitle" Grid.Column="3" Text="Shikimori" Margin="8,0"
                               Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="4" Click="OnShikimoriClose" AutomationProperties.Name="Закрыть Shikimori"
                            ToolTipService.ToolTip="Закрыть Shikimori (Esc)" Style="{StaticResource SubtleButtonStyle}" Padding="8,6">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </Grid>
                <!-- The Shikimori WebView2 HWND covers this area. -->
                <Border x:Name="ShikimoriHost" Grid.Row="1" SizeChanged="OnShikimoriHostSizeChanged" />
            </Grid>
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnShikimoriEscape" />
            </Grid.KeyboardAccelerators>
        </Grid>
    </Grid>
</Window>
